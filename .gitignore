# Virtual environment (~1.1GB locally) — never tracked. CI installs fresh
# from requirements.txt; the Docker image builds its own venv (see
# Dockerfile).
venv/
.venv/
env/

# EasyOCR model weights are NEVER stored in this repo. They're downloaded
# at runtime into ~/.EasyOCR/model (outside this working tree) for local
# dev, and baked into the Docker image at BUILD time (see Dockerfile's
# `deps` stage, EASYOCR_MODULE_PATH) — not via git, not via Git LFS. If a
# model cache ever ends up inside this directory by mistake (e.g.
# EASYOCR_MODULE_PATH pointed here locally), these patterns catch it.
.EasyOCR/
*.pth
*.zip

# Runtime / temp artifacts
temp_uploads/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
**/.pytest_cache/
*.egg-info/

# Secrets / local env
.env
.env.*
!.env.example

# IDE / editor
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Coverage / test reports (generated by CI, not tracked)
pytest-report.xml
htmlcov/
.coverage
